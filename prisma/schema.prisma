generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}
// Usuário
model User {
  id        String   @id @default(cuid()) // Id
  email     String   @unique // (RF-01) Email 
  name      String?  // (RF-01) Nome 
  password  String   // (RF-01) Hash da senha
  createdAt DateTime @default(now())

  tasks Task[]
}

// Tarefas
model Task {
  id          String   @id @default(cuid()) // Id
  title       String   // (RF-02) Título
  description String?  // (RF-02) Descrição
  status      String   @default("Pendente") // Valor padrão "Pendente" do Status
  dueDate     DateTime? // (RF-02) Data de Vencimento opcional

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id])
  userId String // Chave pro prisma
}
